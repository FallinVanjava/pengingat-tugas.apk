# ==============================================================================
# Git Ignore Configuration - Pengingat Tugas Repository
# Cybersecurity & Repository Hygiene Standards
# ==============================================================================

# ── Secrets, Credentials, and Environment Files ──────────────────────────────
*.env
*.env.*
*.pem
*.key
*.p12
*.pfx
*.secret
*.credentials
key.properties
auth.json

# ── Large Binary Artifacts (Tracked via GitHub Releases / CDN) ───────────────
*.apk
*.aab
*.ipa
*.zip
*.tar
*.gz
*.exe
*.dll
*.so
*.dylib

# ── Dart & Flutter Specific ──────────────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
coverage/
**/doc/api/
.widget_preview/

# ── Android & Gradle Specific ────────────────────────────────────────────────
.gradle/
**/.gradle/
**/local.properties
**/GeneratedPluginRegistrant.java
**/.cxx/
**/captures/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/*.keystore
**/*.jks

# ── iOS Specific ─────────────────────────────────────────────────────────────
**/ios/Flutter/ephemeral/
**/ios/Flutter/.last_build_id
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/*.mode1v3
**/*.mode2v3
**/*.moved-aside
**/*.pbxuser
**/*.perspectivev3
**/xcuserdata/
**/DerivedData/

# ── Web & Vercel Specific ────────────────────────────────────────────────────
.vercel/
**/.vercel/
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── IDE & Editor Artifacts ───────────────────────────────────────────────────
.idea/
**/.idea/
*.iml
*.ipr
*.iws
.history/
.atom/

# VS Code - Ignore user specific state, keep workspace configuration
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
pengingat_tugas/.vscode/*
!pengingat_tugas/.vscode/settings.json
!pengingat_tugas/.vscode/launch.json

# ── Operating System Artifacts ───────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
